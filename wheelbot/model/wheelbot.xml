        <geom name="sliding_piston_core" class="visual" type="box" pos="0 0 0.004" size="0.015 0.017 0.030" rgba="0.30 0.33 0.36 0.82"/>
        <geom name="sliding_piston_guide_left" class="visual" type="capsule" fromto="-0.014 0 -0.018 -0.014 0 0.024" size="0.002" rgba="0.16 0.18 0.20 0.26"/>
        <geom name="sliding_piston_guide_right" class="visual" type="capsule" fromto="0.014 0 -0.018 0.014 0 0.024" size="0.002" rgba="0.16 0.18 0.20 0.26"/>
        <geom name="upper_actuator_collar" class="visual" type="box" pos="0 0 0.040" size="0.028 0.032 0.004" rgba="0.50 0.53 0.56 1"/>
        <geom name="wheel_x_motor_bridge" class="visual" type="capsule" fromto="-0.018 0 0.052 0.018 0 0.052" size="0.012" rgba="0.34 0.37 0.40 1"/>
        <geom name="wheel_x_mount_fairing" class="visual" type="ellipsoid" pos="0 0 0.046" size="0.026 0.028 0.014" rgba="0.66 0.68 0.71 0.95"/>

        <body name="wheel_x" pos="0 0 0.066">
          <inertial pos="0 0 0" mass="0.129" diaginertia="0.000120 0.000063 0.000063"/>
          <joint name="q_wheel_x" type="hinge" axis="1 0 0" damping="0.00001"/>
          <geom name="wheel_x_geom" class="tyre_collision" type="mesh" mesh="wheel_y_tire_mesh" euler="0 0 1.57079632679" density="0" rgba="0.09 0.09 0.1 1"/>
          <geom name="wheel_x_hub" class="visual" type="cylinder" fromto="-0.008 0 0 0.008 0 0" size="0.013" rgba="0.20 0.21 0.22 1"/>
          <geom name="wheel_x_inner_ring" class="visual" type="cylinder" fromto="-0.0105 0 0 0.0105 0 0" size="0.024" rgba="0.66 0.48 0.18 1"/>
          <geom name="wheel_x_face_left" class="visual" type="cylinder" pos="-0.0105 0 0" euler="0 1.57079632679 0" size="0.024 0.001" rgba="0.72 0.54 0.22 1"/>
          <geom name="wheel_x_face_right" class="visual" type="cylinder" pos="0.0105 0 0" euler="0 1.57079632679 0" size="0.024 0.001" rgba="0.72 0.54 0.22 1"/>
          <geom name="wheel_x_rotation_dot_left" class="visual" type="sphere" pos="-0.012 0 0.026" size="0.005" rgba="1.0 0.95 0.10 1"/>
          <geom name="wheel_x_rotation_dot_right" class="visual" type="sphere" pos="0.012 0 0.026" size="0.005" rgba="1.0 0.95 0.10 1"/>
        </body>
      </body>

      <body name="wheel_y_end" pos="0 0 0">
        <inertial pos="0 0 -0.014" mass="0.215" diaginertia="0.000179 0.000179 0.000131"/>
        <geom name="lower_body_collision" class="body_collision" type="box" pos="0 0 -0.018" size="0.026 0.030 0.014" density="0" rgba="0 0 0 0" group="3"/>
        <geom name="lower_roll_rocker_left" class="body_collision" type="capsule" fromto="-0.030 0.046 -0.018 0.030 0.046 -0.018" size="0.0045" density="0" rgba="0.76 0.63 0.38 0.95"/>
        <geom name="lower_roll_rocker_right" class="body_collision" type="capsule" fromto="-0.030 -0.046 -0.018 0.030 -0.046 -0.018" size="0.0045" density="0" rgba="0.76 0.63 0.38 0.95"/>
        <geom name="lower_pitch_rocker_front" class="pitch_rocker_collision" type="capsule" fromto="0.034 -0.036 -0.018 0.034 0.036 -0.018" size="0.0045" density="0" group="3" rgba="0.62 0.65 0.68 0.65"/>
        <geom name="lower_pitch_rocker_back" class="pitch_rocker_collision" type="capsule" fromto="-0.034 -0.036 -0.018 -0.034 0.036 -0.018" size="0.0045" density="0" group="3" rgba="0.62 0.65 0.68 0.65"/>
        <geom name="lower_body_core" class="visual" type="box" pos="0 0 -0.026" size="0.024 0.039 0.014" rgba="0.82 0.84 0.86 0.92"/>
        <geom name="lower_housing_shell" class="visual" type="box" pos="0 0 -0.022" size="0.028 0.044 0.012" rgba="0.58 0.61 0.64 0.55"/>
        <geom name="housing_bottom_front" class="visual" type="capsule" fromto="-0.018 0.039 -0.026 0.018 0.039 -0.026" size="0.0045" rgba="0.9 0.91 0.92 1"/>
        <geom name="housing_bottom_back" class="visual" type="capsule" fromto="-0.018 -0.039 -0.026 0.018 -0.039 -0.026" size="0.0045" rgba="0.9 0.91 0.92 1"/>
        <geom name="fixed_outer_sleeve" class="visual" type="box" pos="0 0 -0.004" size="0.031 0.048 0.020" rgba="0.88 0.89 0.90 0.50"/>
        <geom name="lower_actuator_collar" class="visual" type="box" pos="0 0 -0.040" size="0.028 0.032 0.004" rgba="0.50 0.53 0.56 1"/>
        <geom name="lower_piston_guide_left" class="visual" type="capsule" fromto="-0.014 0 -0.024 -0.014 0 0.018" size="0.002" rgba="0.16 0.18 0.20 0.20"/>
        <geom name="lower_piston_guide_right" class="visual" type="capsule" fromto="0.014 0 -0.024 0.014 0 0.018" size="0.002" rgba="0.16 0.18 0.20 0.20"/>
        <geom name="wheel_y_motor_bridge" class="visual" type="capsule" fromto="0 -0.018 -0.052 0 0.018 -0.052" size="0.012" rgba="0.34 0.37 0.40 1"/>
        <geom name="wheel_y_mount_fairing" class="visual" type="ellipsoid" pos="0 0 -0.046" size="0.028 0.026 0.014" rgba="0.66 0.68 0.71 0.95"/>

        <body name="wheel_y" pos="0 0 -0.066">
          <inertial pos="0 0 0" mass="0.129" diaginertia="0.000063 0.000120 0.000063"/>
          <joint name="q_wheel_y" type="hinge" axis="0 1 0" damping="0.00001"/>
          <geom name="wheel_y_geom" class="tyre_collision" type="mesh" mesh="wheel_y_tire_mesh" density="0" rgba="0.09 0.09 0.1 1"/>
          <geom name="wheel_y_hub" class="visual" type="cylinder" fromto="0 -0.008 0 0 0.008 0" size="0.013" rgba="0.20 0.21 0.22 1"/>
          <geom name="wheel_y_inner_ring" class="visual" type="cylinder" fromto="0 -0.0105 0 0 0.0105 0" size="0.024" rgba="0.66 0.48 0.18 1"/>
          <geom name="wheel_y_face_left" class="visual" type="cylinder" pos="0 -0.0105 0" euler="1.57079632679 0 0" size="0.024 0.001" rgba="0.72 0.54 0.22 1"/>
          <geom name="wheel_y_face_right" class="visual" type="cylinder" pos="0 0.0105 0" euler="1.57079632679 0 0" size="0.024 0.001" rgba="0.72 0.54 0.22 1"/>
          <geom name="wheel_y_rotation_dot_left" class="visual" type="sphere" pos="0 -0.012 0.026" size="0.005" rgba="1.0 0.95 0.10 1"/>
          <geom name="wheel_y_rotation_dot_right" class="visual" type="sphere" pos="0 0.012 0.026" size="0.005" rgba="1.0 0.95 0.10 1"/>
        </body>
      </body>

    </body>
  </worldbody>

  <actuator>
    <motor name="tau_wheel_y" joint="q_wheel_y"/>
    <motor name="tau_wheel_x" joint="q_wheel_x"/>
    <motor name="tau_jump" joint="q_jump"
           ctrllimited="true" ctrlrange="-120 120"
           forcelimited="true" forcerange="-120 120"/>
  </actuator>

  <contact>
    <exclude body1="wheel_x_end" body2="wheel_y_end"/>
    <exclude body1="wheel_y_end" body2="wheel_y"/>
    <exclude body1="wheel_y_end" body2="wheel_x"/>
    <exclude body1="wheel_x_end" body2="wheel_y"/>
    <exclude body1="wheel_x_end" body2="wheel_x"/>
    <exclude body1="wheel_y" body2="wheel_x"/>
  </contact>
</mujoco>
